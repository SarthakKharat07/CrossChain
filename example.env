# ==============================================================================
# MiniBridge Environment Template (example.env)
# Copy this file to '.env' and fill in your values.
# NEVER commit your '.env' file or paste private keys into public repositories!
# ==============================================================================

# RPC Endpoints
# Ethereum Sepolia Testnet (Chain ID: 11155111)
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# Polygon Amoy Testnet (Chain ID: 80002)
AMOY_RPC_URL="https://rpc-amoy.polygon.technology"

# Accounts & Keys
# CAUTION: Use a dedicated throwaway testnet wallet with NO real mainnet assets.
# Hex string without '0x' or with '0x' (both supported)
DEPLOYER_PRIVATE_KEY="your_deployer_private_key_here"
RELAYER_PRIVATE_KEY="your_relayer_private_key_here"

# Contract Addresses (populated after deployment)
SEPOLIA_TEST_TOKEN_ADDRESS=""
SEPOLIA_BRIDGE_SOURCE_ADDRESS=""
AMOY_WRAPPED_TOKEN_ADDRESS=""
AMOY_BRIDGE_DESTINATION_ADDRESS=""

# Relayer Parameters
CONFIRMATIONS_SEPOLIA="2"
CONFIRMATIONS_AMOY="5"
POLL_INTERVAL_MS="5000"

# Explorer Verification Keys (Optional for contract verification)
ETHERSCAN_API_KEY=""
POLYGONSCAN_API_KEY=""

